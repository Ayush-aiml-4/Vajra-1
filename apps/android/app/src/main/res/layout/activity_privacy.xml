<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vajra_bg_obsidian"
    android:orientation="vertical">

    <!-- Custom Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btnPrivacyBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_title"
                android:textColor="@color/vajra_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_subtitle"
                android:textColor="@color/vajra_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vajra_border_subtle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Hero Pledge Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_jade_accent"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_badge_jade">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/vajra_jade" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Zero-Covert-Monitoring Guarantee"
                        android:textColor="@color/vajra_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="VAJRA Companion protects endpoints you own using explicit, verifiable cryptographic controls and user-visible permissions."
                        android:textColor="@color/vajra_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Collected Telemetry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.Vajra.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="COLLECTED TELEMETRY"
                    android:textColor="@color/vajra_gold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="• Device identifier &amp; ECDSA P-256 public key fingerprint\n• OS release, device model, and agent build version\n• Signed heartbeat connectivity &amp; battery state (when available)\n• Explicit command execution receipts (Device Status &amp; Ring Alarm)"
                    android:textColor="@color/vajra_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Never Collected -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.Vajra.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NEVER COLLECTED"
                    android:textColor="@color/vajra_jade" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="• Keystrokes, SMS messages, contacts, photos, microphone audio, or camera recordings\n• Continuous background GPS location tracking"
                    android:textColor="@color/vajra_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Permissions Used -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.Vajra.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PERMISSIONS USED" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="• INTERNET — Signed communication with your configured VAJRA server\n• CAMERA — Only during active QR pairing scan\n• POST_NOTIFICATIONS — High-priority Find My Device ring alerts"
                    android:textColor="@color/vajra_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Ownership & Key Removal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_well_code"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="You remain in full control of this device. You can disconnect and permanently delete local Android Keystore keys at any time inside Settings."
                    android:textColor="@color/vajra_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
