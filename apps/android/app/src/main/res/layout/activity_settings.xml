<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vajra_bg_obsidian"
    android:orientation="vertical">

    <!-- Custom Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/vajra_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_subtitle"
                android:textColor="@color/vajra_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vajra_border_subtle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- 1. NOTIFICATIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_badge_gold">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bell_ring"
                            app:tint="@color/vajra_gold" />
                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.Vajra.Overline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="NOTIFICATIONS" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSettingsNotifPerm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Notification Permission: Checking…"
                    android:textColor="@color/vajra_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSettingsChannelState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Checking VAJRA Ring channel and Do Not Disturb status…"
                    android:textColor="@color/vajra_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantNotifPerm"
                    style="@style/Widget.Vajra.Button.Primary"
                    android:layout_marginTop="14dp"
                    android:text="Grant Notification Permission"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenNotifSettings"
                    style="@style/Widget.Vajra.Button.Secondary"
                    android:layout_marginTop="10dp"
                    android:text="Open System Notification Settings" />
            </LinearLayout>

            <!-- 2. PERMISSIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.Vajra.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PERMISSIONS" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_well_code"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Camera (QR Pairing Only)"
                            android:textColor="@color/vajra_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPermCamera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking…"
                            android:textColor="@color/vajra_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/vajra_border_subtle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Post Notifications (Find My Device)"
                            android:textColor="@color/vajra_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPermNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking…"
                            android:textColor="@color/vajra_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Excluded Permissions: SMS, Contacts, Microphone, Call Logs, and continuous background GPS are never requested by this application."
                    android:textColor="@color/vajra_text_muted"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAppPermissions"
                    style="@style/Widget.Vajra.Button.Secondary"
                    android:layout_marginTop="12dp"
                    android:text="Manage System App Permissions" />
            </LinearLayout>

            <!-- 3. DEVICE IDENTITY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.Vajra.Overline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DEVICE IDENTITY" />

                    <TextView
                        android:id="@+id/badgeSettingsEnrollState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_neutral"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="NOT ENROLLED"
                        android:textColor="@color/vajra_text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSettingsDeviceModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/vajra_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSettingsDeviceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/vajra_text_secondary"
                    android:textIsSelectable="true"
                    android:textSize="11sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/txtSettingsKeystoreLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/vajra_jade"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutSettingsFpWell"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_well_code"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Vajra.Overline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PUBLIC KEY FINGERPRINT" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsCopyFp"
                            style="@style/Widget.Vajra.Button.Compact"
                            android:layout_width="wrap_content"
                            android:text="Copy"
                            app:icon="@drawable/ic_copy" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtSettingsFingerprint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/vajra_gold"
                        android:textIsSelectable="true"
                        android:textSize="11sp"
                        android:typeface="monospace" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettingsPairNow"
                    style="@style/Widget.Vajra.Button.Primary"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_connect_device"
                    android:visibility="gone"
                    app:icon="@drawable/ic_qr_scan" />
            </LinearLayout>

            <!-- 4. SECURITY INFORMATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.Vajra.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SECURITY INFORMATION" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="• Key Algorithm: Non-exportable ECDSA P-256 stored inside Android Keystore.\n• Plane-2 Signing: Per-request UTC timestamp + cryptographic nonce replay guard.\n• Transport Policy: System TLS certificate trust store only; HTTP redirects disabled on auth calls."
                    android:textColor="@color/vajra_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettingsPrivacy"
                    style="@style/Widget.Vajra.Button.Secondary"
                    android:layout_marginTop="14dp"
                    android:text="View Privacy &amp; Telemetry Disclosure"
                    app:icon="@drawable/ic_info_privacy" />
            </LinearLayout>

            <!-- 5. APPLICATION CONFIGURATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.Vajra.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="APPLICATION CONFIGURATION" />

                <TextView
                    style="@style/TextAppearance.Vajra.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Server Base URL" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Use HTTPS in production. Server origins are only changed locally here or via QR pairing—never by remote commands."
                    android:textColor="@color/vajra_text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/inputServerUrl"
                    style="@style/Widget.Vajra.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="https://your-vajra-host.example"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveServer"
                    style="@style/Widget.Vajra.Button.Primary"
                    android:layout_marginTop="12dp"
                    android:text="Save Server URL" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/vajra_border_subtle" />

                <TextView
                    android:id="@+id/txtSettingsAppVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App Version: 0.1.0"
                    android:textColor="@color/vajra_text_muted"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </LinearLayout>

            <!-- DANGER ZONE: DISCONNECT -->
            <LinearLayout
                android:id="@+id/layoutSettingsDisconnectCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_error"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.Vajra.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LOCAL KEYSTORE REMOVAL"
                    android:textColor="@color/vajra_crimson" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Deletes the ECDSA key from Android Keystore, cancels scheduled workers, and clears local pairing metadata."
                    android:textColor="@color/vajra_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisconnect"
                    style="@style/Widget.Vajra.Button.Danger"
                    android:layout_marginTop="12dp"
                    android:text="Disconnect / Clear Local Identity" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
