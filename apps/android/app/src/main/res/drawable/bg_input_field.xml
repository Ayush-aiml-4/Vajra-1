<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vajra_surface_well" />
            <stroke android:width="1.5dp" android:color="@color/vajra_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vajra_surface_well" />
            <stroke android:width="1dp" android:color="@color/vajra_border_elevated" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
