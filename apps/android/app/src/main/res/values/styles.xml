<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary Champagne Gold CTA Button (non-clipping, responsive height) -->
    <style name="Widget.Vajra.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vajra_text_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/vajra_gold</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/vajra_text_on_accent</item>
        <item name="rippleColor">#3308090B</item>
    </style>

    <!-- Secondary Graphite Outlined Button -->
    <style name="Widget.Vajra.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vajra_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/vajra_surface_elevated</item>
        <item name="strokeColor">@color/vajra_border_elevated</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/vajra_gold</item>
        <item name="rippleColor">#26C8A66A</item>
    </style>

    <!-- Deep Jade Success CTA Button -->
    <style name="Widget.Vajra.Button.Jade" parent="Widget.Vajra.Button.Primary">
        <item name="backgroundTint">@color/vajra_jade</item>
        <item name="iconTint">@color/vajra_text_on_accent</item>
    </style>

    <!-- Restrained Crimson Destructive / Alert Button -->
    <style name="Widget.Vajra.Button.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vajra_crimson</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/vajra_crimson_surface</item>
        <item name="strokeColor">@color/vajra_crimson_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/vajra_crimson</item>
        <item name="rippleColor">#26E56B63</item>
    </style>

    <!-- Compact Inline Button (for Copy, Open Settings, etc.) -->
    <style name="Widget.Vajra.Button.Compact" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vajra_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/vajra_surface_elevated</item>
        <item name="strokeColor">@color/vajra_border_elevated</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">15dp</item>
        <item name="iconTint">@color/vajra_gold</item>
    </style>

    <!-- Section Overline Label -->
    <style name="TextAppearance.Vajra.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/vajra_text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Input Field Label -->
    <style name="TextAppearance.Vajra.FieldLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/vajra_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Standard Dark Input Box -->
    <style name="Widget.Vajra.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/vajra_text_primary</item>
        <item name="android:textColorHint">@color/vajra_text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
